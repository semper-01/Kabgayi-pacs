# ---------------------------------------------------------------------------
# Kabgayi PACS backend — example environment file
# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in real values. NEVER commit .env;
# it is already git-ignored. All values here are placeholders.

# Django
# Generate a real key, e.g. with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (application data owned by Django; NOT DICOM storage)
# Preferred: a single DATABASE_URL, e.g.
#   postgres://kabgayi_app:password@localhost:5432/kabgayi_pacs
DATABASE_URL=postgres://kabgayi_app:pasword@localhost:5432/kabgayi_pacs

# Alternatively, decomposed variables (ignored when DATABASE_URL is set):
POSTGRES_DB=kabgayi_pacs
POSTGRES_USER=kabgayi_app
POSTGRES_PASSWORD=pasword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
