# Base URL of the Django API. Leave empty to use relative paths (recommended:
# the Vite dev server proxies /api to the backend; production uses nginx).
VITE_API_BASE_URL=

# For `vite dev`: where the Django backend is running (default localhost:8000).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Optional OHIF/nginx origin used by the protected React viewer route.
# When empty, the app uses the browser's current hostname on port 8080 so the
# HttpOnly PACS viewer grant cookie is sent to the DICOMweb gateway.
# If set explicitly, it must use the same hostname as the React app.
VITE_OHIF_BASE_URL=